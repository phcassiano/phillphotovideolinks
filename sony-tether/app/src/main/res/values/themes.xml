<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema escuro do app: dourado como cor de destaque (controles, seleção, cursor). -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/panel</item>
        <item name="android:colorPrimaryDark">@color/background</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:colorControlNormal">@color/text_secondary</item>
        <item name="android:colorControlActivated">@color/gold</item>
        <item name="android:colorControlHighlight">#24FFFFFF</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>

    <style name="AppDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorBackground">@color/card</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:colorControlActivated">@color/gold</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/text_primary</item>
        <item name="android:buttonBarButtonStyle">@style/AppDialogButton</item>
    </style>

    <style name="AppDialogButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">@color/gold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
