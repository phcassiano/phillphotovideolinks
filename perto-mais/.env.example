# URL pública do site (sem barra no final). Usada em canonical, Open Graph e sitemap.
SITE_URL=http://localhost:5173

# Supabase — URL e anon key vão para o navegador.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=cole-aqui-a-anon-key

# SOMENTE SERVIDOR. Nunca exponha no cliente nem faça commit do valor real.
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key

# Segredo para gerar o hash de sessão das métricas (qualquer string longa e aleatória).
METRICS_SALT=troque-por-uma-string-aleatoria
