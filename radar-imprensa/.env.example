# =============================================================================
# Radar de Imprensa — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou configure na Vercel.
# NUNCA versione valores reais.
# =============================================================================

# --- Supabase (obrigatório) --------------------------------------------------
# Atenção: variáveis NEXT_PUBLIC_* são fixadas no momento do `next build`.
# Após alterá-las, é preciso refazer o build/deploy.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon/publishable). A segurança vem das políticas RLS do banco.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do app (usada nos links de confirmação de e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mail exibido na página de privacidade para titulares sem conta
NEXT_PUBLIC_PRIVACY_EMAIL=privacidade@radar-imprensa.example

# --- Somente servidor (segredos) --------------------------------------------
# Chave service_role: usada apenas no endpoint de cron (servidor). Nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Protege POST /api/cron/verificacoes (mínimo de 32 caracteres; gere com `openssl rand -hex 32`)
CRON_SECRET=

# --- Verificação periódica ----------------------------------------------------
# none  = desativado (padrão): verificações ficam registradas como "ignoradas"
# demo  = provedor demonstrativo com evidências FICTÍCIAS (somente testes)
# brave = Brave Search API (oficial) — requer BRAVE_SEARCH_API_KEY
VERIFICATION_PROVIDER=none
BRAVE_SEARCH_API_KEY=

# --- Feature flags ------------------------------------------------------------
# "Encontrar jornalistas para minha pauta" (fase 2). Desabilitado no MVP.
FEATURE_PAUTA_MATCHING=false

# --- Testes -------------------------------------------------------------------
# PostgreSQL usado pelos testes de banco (o banco radar_imprensa_test é recriado)
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/postgres
# Binário do PostgREST para o E2E local (npm run test:e2e)
POSTGREST_BIN=postgrest
