# Copie para .env e ajuste.
PORT=3000
HOST=127.0.0.1

# Login do /stats (basic auth). Sem os dois, o /stats fica desligado.
STATS_USER=phill
STATS_PASS=troque-por-uma-senha-longa

# Onde fica o clicks.log (relativo à pasta do projeto ou caminho absoluto)
DATA_DIR=data

# Fuso usado para "hoje", "7 dias" etc. no /stats
STATS_TZ=America/Sao_Paulo
