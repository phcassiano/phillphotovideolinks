{
  "rewrites": [
    {
      "source": "/manifest.webmanifest",
      "destination": "/site/manifest.webmanifest"
    },
    {
      "source": "/sw.js",
      "destination": "/site/sw.js"
    },
    {
      "source": "/icon.svg",
      "destination": "/site/icon.svg"
    },
    {
      "source": "/icons/:file",
      "destination": "/site/icons/:file"
    },
    {
      "source": "/admin",
      "destination": "/site/admin.html"
    },
    {
      "source": "/privacidade",
      "destination": "/site/privacidade.html"
    },
    {
      "source": "/termos",
      "destination": "/site/termos.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
